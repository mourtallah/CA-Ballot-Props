# Server
PORT=3000
NODE_ENV=development

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=notifeed
DB_USER=notifeed_user
DB_PASSWORD=notifeed_pass
DB_POOL_MIN=2
DB_POOL_MAX=10

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Fan-out Configuration
FANOUT_THRESHOLD=10000
FANOUT_HYBRID_THRESHOLD=1000
CELEBRITY_HINT_FRACTION=0.1
FANOUT_RATE_LIMIT_PER_SEC=5000
INBOX_TTL_SECONDS=86400

# WebSocket
WS_PORT=3001
WS_SERVER_ID=ws-server-1

# Reliability
REPLAY_BUFFER_SIZE=500
REPLAY_TTL_SECONDS=300

# Metrics
METRICS_PORT=9090
ENABLE_METRICS=true

# JWT
JWT_SECRET=change_this_in_production_please
JWT_EXPIRY=7d

# Feature Flags
ENABLE_CELEBRITY_HINTS=true
ENABLE_REPLAY_BUFFER=true
